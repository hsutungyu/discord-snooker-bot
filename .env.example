# Copy this file to .env and fill in your values
DATABASE_URL=postgresql://user:password@host:5432/dbname
FRONTEND_ORIGINS=http://localhost:5173

# Discord bot — real-time notifications (optional)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_NOTIFY_CHANNEL_ID=123456789012345678

# Optional: mirror sync integration (used by /api/mirror-sync)
GITEA_URL=https://git.19371928.xyz
GITEA_TOKEN=your_gitea_token_here
GITEA_MIRROR_REPO=automation/discord-snooker-bot-github-mirror
